if (not np.isfinite(TRAIN_PRICE_SCALE) or TRAIN_PRICE_SCALE <= 0
        or np.any(np.abs(VAL_PRICE) < 1e-8)):
    raise ValueError("综合指标要求训练价格尺度为正，且验证 Close 不为零")


def validation_score(pred_scaled):

    pred_price = scaler_y.inverse_transform(
        np.asarray(pred_scaled).reshape(-1, 1)).reshape(-1)
    if pred_price.size != VAL_PRICE.size or not np.isfinite(pred_price).all():
        raise ValueError("验证预测长度或数值不合法")
    absolute_error = np.abs(pred_price - VAL_PRICE)
    metrics = {
        "mae": float(np.mean(absolute_error)),
        "rmse": float(np.sqrt(np.mean(absolute_error ** 2))),
        "mape": float(np.mean(absolute_error / np.abs(VAL_PRICE))),
    }
    metrics["score"] = (
        WEIGHT_MAE * metrics["mae"] / TRAIN_PRICE_SCALE
        + WEIGHT_RMSE * metrics["rmse"] / TRAIN_PRICE_SCALE
        + WEIGHT_MAPE * metrics["mape"])
    return metrics



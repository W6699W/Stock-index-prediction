def decode_candidate(position):

    p = np.clip(np.asarray(position, dtype=np.float64), 0.0, 1.0)
    if p.shape != (SEARCH_DIM,) or not np.isfinite(p).all():
        raise ValueError("MFPOA 候选向量必须是有限的 7 维向量")

    def category(value, options):
        return options[min(int(value * len(options)), len(options) - 1)]

    return {
        "d_model": category(p[0], (32, 64, 96, 128)),
        "num_layers": category(p[1], (1, 2, 3, 4)),
        "n_heads": category(p[2], (2, 4, 8)),
        "nb_features": category(p[3], (32, 64, 128, 256)),
        "local_kernel_size": category(p[4], (3, 5)),
        "dropout": float(0.05 + p[5] * 0.25),
        "lr": float(np.exp(np.log(1e-4) + p[6] *
                           (np.log(1e-2) - np.log(1e-4)))),
    }


def trial_validation_score(cfg, trial_seed, max_epochs=SEARCH_EPOCHS,
                           patience=SEARCH_PATIENCE):

    seed_everything(trial_seed)
    trial_model = IPerformerModel(
        input_dim=INPUT_DIM, seq_len=SEQ_LEN,
        d_model=cfg["d_model"], num_layers=cfg["num_layers"],
        n_heads=cfg["n_heads"], nb_features=cfg["nb_features"],
        local_kernel_size=cfg["local_kernel_size"],
        dim_feedforward=DIM_FEEDFORWARD, dropout=cfg["dropout"],
        use_time_pos_embed=USE_TIME_POS_EMBED,
        redraw_projection=REDRAW_PROJECTION).to(device)
    trial_optimizer = optim.AdamW(trial_model.parameters(),
                                  lr=cfg["lr"], weight_decay=WEIGHT_DECAY)
    trial_scheduler = optim.lr_scheduler.ReduceLROnPlateau(
        trial_optimizer, mode="min", factor=SCHEDULER_FACTOR,
        patience=SCHEDULER_PATIENCE, min_lr=MIN_LR)
    trial_criterion = nn.SmoothL1Loss()
    train_generator = torch.Generator().manual_seed(trial_seed)
    trial_train_loader = DataLoader(
        TensorDataset(torch_X_train, torch_y_train),
        batch_size=BATCH_SIZE, shuffle=True, generator=train_generator)
    trial_val_loader = DataLoader(
        TensorDataset(torch_X_val, torch_y_val),
        batch_size=BATCH_SIZE, shuffle=False)

    best_score, best_metrics, stale, best_epoch = float("inf"), None, 0, 0
    for epoch in range(1, max_epochs + 1):
        trial_model.train()
        for xb, yb in trial_train_loader:
            xb, yb = xb.to(device), yb.to(device)
            trial_optimizer.zero_grad(set_to_none=True)
            output = trial_model(xb)
            loss = trial_criterion(output, yb)
            if not torch.isfinite(loss):
                raise FloatingPointError("搜索候选训练损失非有限值")
            loss.backward()
            torch.nn.utils.clip_grad_norm_(trial_model.parameters(), GRAD_CLIP)
            trial_optimizer.step()

        trial_model.eval()
        val_loss_sum, val_count, val_predictions = 0.0, 0, []
        with torch.no_grad():
            for xb, yb in trial_val_loader:
                xb, yb = xb.to(device), yb.to(device)
                output = trial_model(xb)
                val_loss_sum += float(trial_criterion(output, yb)) * len(xb)
                val_predictions.append(output.detach().cpu().numpy())
                val_count += len(xb)
        val_loss = val_loss_sum / val_count
        metrics = validation_score(np.concatenate(val_predictions))
        if not np.isfinite(val_loss) or not np.isfinite(metrics["score"]):
            raise FloatingPointError("搜索候选验证指标非有限值")
        trial_scheduler.step(metrics["score"])
        if metrics["score"] < best_score - 1e-12:
            best_score = metrics["score"]
            best_metrics = metrics
            best_epoch = epoch
            stale = 0
        else:
            stale += 1
            if stale >= patience:
                break

    return float(best_score), int(best_epoch), best_metrics



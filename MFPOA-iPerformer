    lines = ["| Dataset | MAE | RMSE | MAPE (%) | R² (%) |",
             "|---|---:|---:|---:|---:|"]
    for _, row in frame.iterrows():
        lines.append("| {} | {:.4f} | {:.4f} | {:.3f} | {:.3f} |".format(
            row["Dataset"], row["MAE"], row["RMSE"],
            row["MAPE(%)"], row["R²(%)"]))
    return "\n".join(lines)


def _save(fig, destination):
    fig.savefig(str(destination.with_suffix(".png")), dpi=600,
                bbox_inches="tight", facecolor="white")
    fig.savefig(str(destination.with_suffix(".pdf")),
                bbox_inches="tight", facecolor="white")
    plt.close(fig)


def _set_style():
    plt.rcParams.update({
        "font.family": "DejaVu Sans", "font.size": 10,
        "axes.spines.top": False, "axes.spines.right": False,
        "axes.labelsize": 11, "axes.titlesize": 12,
        "figure.dpi": 120, "savefig.transparent": False,
    })


def _scores(y, pred):
    delta = np.asarray(pred) - np.asarray(y)
    return {"MAE": float(np.mean(np.abs(delta))),
            "RMSE": float(np.sqrt(np.mean(delta * delta)))}


def _baseline_rows(test_true, candidate_paths):
    rows, notes = [], []
    for label, path in candidate_paths:
        pred_file = path / "test_pred_vs_true.csv"
        if not pred_file.is_file():
            notes.append(f"{label}: 未找到独立保存的预测 CSV，未作比较。")
            continue
        table = pd.read_csv(pred_file)
        if not {"y_test_true", "y_test_pred"}.issubset(table.columns):
            notes.append(f"{label}: CSV 列不匹配，未作比较。")
            continue
        y_base = table["y_test_true"].to_numpy(dtype=float)
        if (len(y_base) != len(test_true) or
                not np.allclose(y_base, test_true, atol=1e-4, rtol=1e-7)):
            notes.append(f"{label}: 测试标签不一致，禁止跨数据划分比较。")
            continue
        rows.append({"Model": label, **_scores(
            test_true, table["y_test_pred"].to_numpy(dtype=float))})
    return rows, notes



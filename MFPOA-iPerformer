def orthogonal_matrix_chunk(cols, device=None):


    unstructured_block = torch.randn((cols, cols), device=device)
    q, r = torch.linalg.qr(unstructured_block, mode="reduced")


    d = torch.diag(r)
    ph = torch.sign(d)
    ph[ph == 0] = 1.0
    q = q * ph.unsqueeze(0)

    return q.t()


def gaussian_orthogonal_random_matrix(
    nb_rows,
    nb_columns,
    nb_heads,
    scaling=0,
    device=None
):


    final_matrices = []

    for _ in range(nb_heads):
        blocks = []

        nb_full_blocks = nb_rows // nb_columns
        remaining_rows = nb_rows % nb_columns

        for _ in range(nb_full_blocks):
            q = orthogonal_matrix_chunk(nb_columns, device=device)
            blocks.append(q)

        if remaining_rows > 0:
            q = orthogonal_matrix_chunk(nb_columns, device=device)
            blocks.append(q[:remaining_rows])

        final_matrix = torch.cat(blocks, dim=0)

        if scaling == 0:

            multiplier = torch.randn((nb_rows, nb_columns), device=device).norm(dim=1)
        elif scaling == 1:

            multiplier = math.sqrt(float(nb_columns)) * torch.ones((nb_rows,), device=device)
        else:
            raise ValueError("scaling must be 0 or 1")

        final_matrix = final_matrix * multiplier.unsqueeze(1)
        final_matrices.append(final_matrix)

    projection_matrix = torch.stack(final_matrices, dim=0)
    return projection_matrix


def softmax_kernel_favor(
    data,
    projection_matrix,
    is_query,
    eps=1e-6
):


    B, H, N, Dh = data.shape


    data_normalizer = Dh ** -0.25
    data = data * data_normalizer

    projection_matrix = projection_matrix.to(data.device)


    data_dash = torch.einsum(
        "bhnd,hmd->bhnm",
        data,
        projection_matrix
    )


    diag_data = (data ** 2).sum(dim=-1, keepdim=True) / 2.0
    data_dash = data_dash - diag_data


    if is_query:

        max_val = torch.max(data_dash, dim=-1, keepdim=True).values
    else:

        max_val = torch.max(
            data_dash.reshape(B, H, -1),
            dim=-1,
            keepdim=True
        ).values.reshape(B, H, 1, 1)

    data_dash = data_dash - max_val.detach()

    ratio = projection_matrix.shape[1] ** -0.5
    data_prime = ratio * (torch.exp(data_dash) + eps)

    return data_prime


class PerformerAttention(nn.Module):


    def __init__(
        self,
        d_model=64,
        n_heads=4,
        nb_features=128,
        dropout=0.1,
        redraw_projection=False
    ):
        super().__init__()

        assert d_model % n_heads == 0, "d_model 必须能被 n_heads 整除"

        self.d_model = d_model
        self.n_heads = n_heads
        self.head_dim = d_model // n_heads
        self.nb_features = nb_features
        self.redraw_projection = redraw_projection

        self.to_q = nn.Linear(d_model, d_model)
        self.to_k = nn.Linear(d_model, d_model)
        self.to_v = nn.Linear(d_model, d_model)

        self.out_proj = nn.Linear(d_model, d_model)
        self.dropout = nn.Dropout(dropout)

        projection = gaussian_orthogonal_random_matrix(
            nb_rows=nb_features,
            nb_columns=self.head_dim,
            nb_heads=n_heads,
            scaling=0,
            device=None
        )

        self.register_buffer("projection_matrix", projection)

    @torch.no_grad()
    def redraw_projection_matrix(self):
        projection = gaussian_orthogonal_random_matrix(
            nb_rows=self.nb_features,
            nb_columns=self.head_dim,
            nb_heads=self.n_heads,
            scaling=0,
            device=self.projection_matrix.device
        )
        self.projection_matrix.copy_(projection)

    def forward(self, x):
        if self.redraw_projection and self.training:
            self.redraw_projection_matrix()

        B, N, C = x.shape

        q = self.to_q(x)
        k = self.to_k(x)
        v = self.to_v(x)

        q = q.view(B, N, self.n_heads, self.head_dim).transpose(1, 2)
        k = k.view(B, N, self.n_heads, self.head_dim).transpose(1, 2)
        v = v.view(B, N, self.n_heads, self.head_dim).transpose(1, 2)

        q_prime = softmax_kernel_favor(
            q,
            self.projection_matrix,
            is_query=True
        )

        k_prime = softmax_kernel_favor(
            k,
            self.projection_matrix,
            is_query=False
        )


        kv = torch.einsum(
            "bhnm,bhnd->bhmd",
            k_prime,
            v
        )

        k_sum = k_prime.sum(dim=2)

        z = 1.0 / (
            torch.einsum(
                "bhnm,bhm->bhn",
                q_prime,
                k_sum
            ) + 1e-6
        )

        out = torch.einsum(
            "bhnm,bhmd,bhn->bhnd",
            q_prime,
            kv,
            z
        )

        out = out.transpose(1, 2).contiguous().view(B, N, C)
        out = self.out_proj(out)
        out = self.dropout(out)

        return out


class PerformerEncoderLayer(nn.Module):


    def __init__(
        self,
        d_model=64,
        n_heads=4,
        nb_features=128,
        dim_feedforward=128,
        dropout=0.1,
        redraw_projection=False
    ):
        super().__init__()

        self.norm1 = nn.LayerNorm(d_model)

        self.attn = PerformerAttention(
            d_model=d_model,
            n_heads=n_heads,
            nb_features=nb_features,
            dropout=dropout,
            redraw_projection=redraw_projection
        )

        self.norm2 = nn.LayerNorm(d_model)

        self.ffn = nn.Sequential(
            nn.Linear(d_model, dim_feedforward),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(dim_feedforward, d_model),
            nn.Dropout(dropout)
        )

    def forward(self, x):
        x = x + self.attn(self.norm1(x))
        x = x + self.ffn(self.norm2(x))
        return x


class LocalGlobalPerformerEncoderLayer(PerformerEncoderLayer):

    def __init__(self, *, local_kernel_size=3, **encoder_kwargs):
        super().__init__(**encoder_kwargs)
        if local_kernel_size < 3 or local_kernel_size % 2 != 1:
            raise ValueError("局部卷积核必须为大于等于 3 的奇数")
        d_model = encoder_kwargs.get("d_model", 64)
        dropout = encoder_kwargs.get("dropout", 0.1)
        self.local_depthwise = nn.Conv1d(
            d_model, d_model, kernel_size=local_kernel_size,
            padding=local_kernel_size // 2, groups=d_model)
        self.local_activation = nn.GELU()
        self.local_pointwise = nn.Conv1d(d_model, d_model, kernel_size=1)
        self.local_dropout = nn.Dropout(dropout)


        nn.init.zeros_(self.local_pointwise.weight)
        nn.init.zeros_(self.local_pointwise.bias)

    def branch_updates(self, x):

        normalized = self.norm1(x)
        global_update = self.attn(normalized)
        local_update = self.local_depthwise(normalized.transpose(1, 2))
        local_update = self.local_activation(local_update)
        local_update = self.local_pointwise(local_update).transpose(1, 2)
        local_update = self.local_dropout(local_update)
        return global_update, local_update

    def forward(self, x):
        global_update, local_update = self.branch_updates(x)
        x = x + global_update + local_update
        x = x + self.ffn(self.norm2(x))
        return x


class PerformerModel(nn.Module):


    def __init__(
        self,
        input_dim,
        seq_len,
        d_model=64,
        num_layers=3,
        n_heads=4,
        nb_features=128,
        dim_feedforward=128,
        dropout=0.1,
        use_time_pos_embed=True,
        redraw_projection=False,
        encoder_layer_cls=PerformerEncoderLayer,
        encoder_layer_kwargs=None
    ):
        super().__init__()

        self.input_dim = input_dim
        self.seq_len = seq_len
        self.d_model = d_model
        self.use_time_pos_embed = use_time_pos_embed

        self.input_embedding = nn.Linear(input_dim, d_model)

        if self.use_time_pos_embed:
            self.time_pos_embed = nn.Parameter(
                torch.zeros(1, seq_len, d_model)
            )
        else:
            self.time_pos_embed = None

        layer_kwargs = {} if encoder_layer_kwargs is None else dict(encoder_layer_kwargs)
        self.layers = nn.ModuleList([
            encoder_layer_cls(
                d_model=d_model,
                n_heads=n_heads,
                nb_features=nb_features,
                dim_feedforward=dim_feedforward,
                dropout=dropout,
                redraw_projection=redraw_projection,
                **layer_kwargs
            )
            for _ in range(num_layers)
        ])

        self.norm = nn.LayerNorm(d_model)
        self.head = nn.Linear(d_model, 1)

    def forward(self, x, return_features=False):


        x = self.input_embedding(x)

        if self.time_pos_embed is not None:
            x = x + self.time_pos_embed[:, :x.size(1), :]

        for layer in self.layers:
            x = layer(x)

        x = self.norm(x)

        pooled = x.mean(dim=1)
        out = self.head(pooled)

        if return_features:
            return out, x, pooled

        return out


class IPerformerModel(PerformerModel):

    def __init__(self, *, local_kernel_size=3, **performer_kwargs):
        super().__init__(
            encoder_layer_cls=LocalGlobalPerformerEncoderLayer,
            encoder_layer_kwargs={"local_kernel_size": local_kernel_size},
            **performer_kwargs)


"""Python port of the authors' POA exploration, exploitation and phase switching.

Sources (compare equations and the MATLAB functions Exploration.m,
Exploitation.m and Puma.m):
https://github.com/Benyamin-abdollahzadeh/Puma-Optimizer-PO-

The MATLAB routine is iteration-based. This port completes MAX_ITER rounds.
Actual objective calls are recorded separately, including initialization.
"""

from dataclasses import dataclass
from time import perf_counter
from typing import Callable, Optional

import numpy as np


@dataclass
class Result:
    best_x: np.ndarray
    best_f: float
    fes: int
    seconds: float
    first_target_fe: Optional[int]
    first_target_seconds: Optional[float]
    trace_fes: np.ndarray
    trace_best_f: np.ndarray
    trace_phase: list[str]
    trace_iteration: np.ndarray
    phase_history: list[dict]


class POA:
    name = "POA"

    def _make_rng(self, seed):
        return np.random.default_rng(seed)

    def __init__(self, pop_size: int = 30, max_iter: int = 200):
        if pop_size < 7 or max_iter < 3:
            raise ValueError("Need at least 7 agents and 3 warmup iterations")
        self.pop_size = int(pop_size)
        self.max_iter = int(max_iter)

        self.expected_fes = self.pop_size * (self.max_iter + 4)

    def _modify_candidate(self, candidate, current, best, phase, scores, rng):

        return candidate

    def _reset_variant(self, dim):
        pass

    def _on_accepted(self, phase, old_x, new_x, old_f, new_f):
        pass

    def _set_bounds(self, lb, ub):

        self._lb, self._ub = lb, ub

    def _select_warmup_survivors(self, population, cost, n):

        return np.argsort(cost, kind="stable")[:n]

    def _observe_population(self, population, cost, lb, ub):
        pass

    def solve(self, objective: Callable, lb, ub, seed: int,
              target_f: Optional[float] = None) -> Result:
        start = perf_counter()
        rng = self._make_rng(seed)
        lb = np.asarray(lb, dtype=float)
        ub = np.asarray(ub, dtype=float)
        dim, n = len(lb), self.pop_size
        if ub.shape != lb.shape or not np.all(ub > lb):
            raise ValueError("Bounds must have matching shapes and ub > lb")

        self._reset_variant(dim)
        self._set_bounds(lb, ub)

        self._fes = 0
        self._best_f = float("inf")
        self._best_x = np.empty(dim, dtype=float)
        self._first_target_fe = None
        self._first_target_seconds = None
        self._trace_fes, self._trace_best_f = [], []
        self._trace_phase, self._trace_iteration = [], []
        self._phase_history = []
        self._phase = "INITIAL"
        self._iteration = 0
        self._target_f = target_f

        def evaluate(x):
            val = float(objective(x))
            if not np.isfinite(val):
                raise FloatingPointError("Objective returned a nonfinite value")
            self._fes += 1
            if val < self._best_f:
                self._best_f = val
                self._best_x = np.asarray(x, dtype=float).copy()
            if (self._target_f is not None and self._first_target_fe is None
                    and self._best_f <= self._target_f):
                self._first_target_fe = self._fes
                self._first_target_seconds = perf_counter() - start
            self._trace_fes.append(self._fes)
            self._trace_best_f.append(self._best_f)
            self._trace_phase.append(self._phase)
            self._trace_iteration.append(self._iteration)
            return val

        population = rng.uniform(lb, ub, size=(n, dim))
        cost = np.array([evaluate(x) for x in population], dtype=float)
        self._observe_population(population, cost, lb, ub)
        initial_best_f = float(np.min(cost))
        best_x = self._best_x.copy()
        best_f = self._best_f


        explore_best, exploit_best = [], []
        for it in range(1, 4):
            self._iteration = it
            self._phase = "EXPLORATION_WARMUP"
            exp_x, exp_f = self._exploration(population.copy(), cost.copy(),
                                             best_x, (0., 0.), lb, ub, rng, evaluate)
            explore_best.append(float(np.min(exp_f)))
            self._phase = "EXPLOITATION_WARMUP"
            dev_x, dev_f = self._exploitation(population.copy(), cost.copy(),
                                              best_x, (0., 0.), lb, ub, rng, evaluate, it)
            exploit_best.append(float(np.min(dev_f)))
            population = np.vstack((population, exp_x, dev_x))
            cost = np.concatenate((cost, exp_f, dev_f))
            keep = self._select_warmup_survivors(population, cost, n)
            population, cost = population[keep].copy(), cost[keep].copy()
            best_x, best_f = population[0].copy(), float(cost[0])
            self._observe_population(population, cost, lb, ub)
            self._phase_history.append({"iteration": it, "phase": "BOTH",
                                        "score_explore": None, "score_exploit": None,
                                        "fes": self._fes, "best_f": best_f,
                                        "n_explore": n, "n_exploit": n,
                                        "reward_explore": None, "reward_exploit": None,
                                        "radius_explore": getattr(self, "_radius_explore", None),
                                        "radius_exploit": getattr(self, "_radius_exploit", None)})


        seq_cost = np.ones((2, 3), dtype=float)
        seq_time = np.ones((2, 3), dtype=float)
        seq_cost[0] = [abs(initial_best_f - explore_best[0]),
                       abs(explore_best[1] - explore_best[0]),
                       abs(explore_best[2] - explore_best[1])]
        seq_cost[1] = [abs(initial_best_f - exploit_best[0]),
                       abs(exploit_best[1] - exploit_best[0]),
                       abs(exploit_best[2] - exploit_best[1])]
        pf = np.array([0.5, 0.5, 0.3])
        historical_nonzero = [float(v) for v in seq_cost.ravel() if v != 0.]
        f1 = pf[0] * seq_cost[:, 0] / seq_time[:, 0]
        f2 = pf[1] * seq_cost.sum(axis=1) / seq_time.sum(axis=1)
        scores = pf[0] * f1 + pf[1] * f2
        unselected = np.ones(2, dtype=int)
        f3 = np.zeros(2, dtype=float)
        mega = np.full(2, 0.99, dtype=float)
        flag_change = 0

        for it in range(4, self.max_iter + 1):
            self._iteration = it
            before_scores = scores.copy()
            selected = 0 if scores[0] > scores[1] else 1
            self._phase = ("EXPLORATION" if selected == 0 else "EXPLOITATION")
            if selected == 0:
                population, cost = self._exploration(population, cost, best_x,
                                                      tuple(scores), lb, ub, rng, evaluate)
            else:
                population, cost = self._exploitation(population, cost, best_x,
                                                       tuple(scores), lb, ub, rng, evaluate, it)

            self._observe_population(population, cost, lb, ub)
            count_select = unselected.copy()
            unselected[1 - selected] += 1
            unselected[selected] = 1
            f3[selected] = pf[2]
            f3[1 - selected] += pf[2]
            candidate_best = int(np.argmin(cost))
            new_best_f = float(cost[candidate_best])
            seq_cost[selected, 2] = seq_cost[selected, 1]
            seq_cost[selected, 1] = seq_cost[selected, 0]
            seq_cost[selected, 0] = abs(best_f - new_best_f)
            if seq_cost[selected, 0] != 0.:
                historical_nonzero.append(float(seq_cost[selected, 0]))
            if new_best_f < best_f:
                best_f, best_x = new_best_f, population[candidate_best].copy()

            if flag_change != selected:
                flag_change = selected
                seq_time[:, 2] = seq_time[:, 1].copy()
                seq_time[:, 1] = seq_time[:, 0].copy()
                seq_time[:, 0] = count_select

            f1 = pf[0] * seq_cost[:, 0] / seq_time[:, 0]
            f2 = pf[1] * seq_cost.sum(axis=1) / seq_time.sum(axis=1)

            if before_scores[0] < before_scores[1]:
                mega[0] = max(mega[0] - 0.01, 0.01)
                mega[1] = 0.99
            elif before_scores[0] > before_scores[1]:
                mega[0] = 0.99
                mega[1] = max(mega[1] - 0.01, 0.01)


            min_history = min(historical_nonzero, default=0.)
            scores = mega * (f1 + f2) + (1. - mega) * min_history * f3
            self._phase_history.append({"iteration": it, "phase": self._phase,
                                        "score_explore": float(before_scores[0]),
                                        "score_exploit": float(before_scores[1]),
                                        "fes": self._fes, "best_f": best_f,
                                        "n_explore": n if selected == 0 else 0,
                                        "n_exploit": n if selected == 1 else 0,
                                        "reward_explore": None, "reward_exploit": None,
                                        "radius_explore": getattr(self, "_radius_explore", None),
                                        "radius_exploit": getattr(self, "_radius_exploit", None)})

        if self._fes != self.expected_fes:
            raise RuntimeError(f"Expected {self.expected_fes} evaluations; got {self._fes}")
        return Result(self._best_x.copy(), float(self._best_f), self._fes,
                      perf_counter() - start, self._first_target_fe,
                      self._first_target_seconds,
                      np.asarray(self._trace_fes, dtype=int),
                      np.asarray(self._trace_best_f, dtype=float),
                      self._trace_phase[:],
                      np.asarray(self._trace_iteration, dtype=int),
                      self._phase_history[:])

    def _exploration(self, pop, fitness, best, scores, lb, ub, rng, evaluate):
        n, dim = pop.shape
        order = np.argsort(fitness, kind="stable")
        pop, fitness = pop[order].copy(), fitness[order].copy()
        pcr = 0.20
        p = (1. - pcr) / n
        for i in range(n):
            candidate = self._explore_candidate(pop, i, best, scores, pcr, lb, ub, rng)
            value = evaluate(candidate)
            if value < fitness[i]:
                self._on_accepted("EXPLORATION", pop[i].copy(), candidate,
                                  fitness[i], value)
                pop[i], fitness[i] = candidate, value
            else:
                pcr += p
        return pop, fitness

    def _explore_candidate(self, pop, i, best, scores, pcr, lb, ub, rng):
        n, dim = pop.shape
        x = pop[i]
        picks = rng.permutation(n)
        picks = picks[picks != i][:6]
        a, b, c, d, e, f = picks
        gain = 2. * rng.random() - 1.
        if rng.random() < 0.5:
            y = rng.uniform(lb, ub)
        else:
            ab = pop[a] - pop[b]
            cd = pop[c] - pop[d]
            ef = pop[e] - pop[f]
            y = pop[a] + gain * ab + gain * ((ab - cd) + (cd - ef))
        y = np.clip(y, lb, ub)
        j0 = rng.integers(dim)
        mask = rng.random(dim) <= pcr
        mask[j0] = True
        candidate = np.where(mask, y, x)
        return np.clip(self._modify_candidate(candidate, x, best,
                                               "EXPLORATION", scores, rng), lb, ub)

    def _exploitation(self, pop, fitness, best, scores, lb, ub, rng, evaluate, iteration):
        n, dim = pop.shape
        for i in range(n):
            candidate = self._exploit_candidate(pop, i, best, scores, lb, ub, rng, iteration)
            value = evaluate(candidate)
            if value < fitness[i]:
                self._on_accepted("EXPLOITATION", pop[i].copy(), candidate,
                                  fitness[i], value)
                pop[i], fitness[i] = candidate, value
        return pop, fitness

    def _exploit_candidate(self, pop, i, best, scores, lb, ub, rng, iteration):
        n, dim = pop.shape
        q, beta = 0.67, 2.
        beta1 = 2. * rng.random()
        beta2 = rng.standard_normal(dim)
        w, v = rng.standard_normal(dim), rng.standard_normal(dim)
        f1 = rng.standard_normal(dim) * np.exp(2. - iteration * (2. / self.max_iter))
        f2 = w * (v ** 2) * np.cos((2. * rng.random()) * w)
        mbest = np.mean(pop) / n
        r1 = 2. * rng.random() - 1.
        s1 = (2. * rng.random() - 1.) + rng.standard_normal(dim)
        s2 = f1 * r1 * pop[i] + f2 * (1. - r1) * best


        denom = float(np.dot(s1, s1))
        vec = float(np.dot(s2, s1) / denom) if denom > 1e-300 else 0.0
        if rng.random() <= 0.5:
            if rng.random() > q:
                peer = pop[rng.integers(n)]
                with np.errstate(over="ignore"):
                    candidate = best + beta1 * np.exp(beta2) * (peer - pop[i])
            else:
                candidate = beta1 * vec - best
        else:
            peer = pop[rng.integers(n)]
            sign = (-1.) ** rng.integers(0, 2)
            candidate = (mbest * peer - sign * pop[i]) / (1. + beta * rng.random())
        candidate = np.nan_to_num(candidate, nan=0., posinf=1e308, neginf=-1e308)
        candidate = np.clip(candidate, lb, ub)
        return np.clip(self._modify_candidate(candidate, pop[i], best,
                                               "EXPLOITATION", scores, rng), lb, ub)


"""Differential-exploration operator competition shared by MPOA/MFPOA.

One strategy is selected before each differential candidate is generated.
Feedback uses its single evaluated result after the reference policy, crossover and bounds. The 50% uniform branch and exploitation are not modified by M.
Inspired by adaptive operator selection; not a reproduction of full SaDE.
"""

import numpy as np


class MultiStrategyMixin:
    strategy_names = ("POA_DIFF", "DE_RAND_1", "DE_CURRENT_TO_RAND_1")

    def __init__(self, pop_size=30, max_iter=200, m_enabled=True, m_scale=0.50,
                 m_quality_alpha=0.10, m_probability_alpha=0.20,
                 m_min_probability=0.10, m_gain_weight=0.50,
                 m_initial_quality=0.50, **kwargs):
        if not isinstance(m_enabled, (bool, np.bool_)):
            raise ValueError("m_enabled must be boolean")
        settings = np.asarray([m_scale, m_quality_alpha, m_probability_alpha,
                               m_min_probability, m_gain_weight, m_initial_quality])
        if not np.all(np.isfinite(settings)):
            raise ValueError("M settings must be finite")
        if not 0 < m_scale <= 2:
            raise ValueError("m_scale must be in (0, 2]")
        if not 0 < m_quality_alpha <= 1 or not 0 < m_probability_alpha <= 1:
            raise ValueError("M smoothing rates must be in (0, 1]")
        if not 0 < m_min_probability < 1 / len(self.strategy_names):
            raise ValueError("Require 0 < min probability < 1/3")
        if not 0 <= m_gain_weight <= 1 or not 0 < m_initial_quality <= 1:
            raise ValueError("gain_weight must be in [0,1]; initial_quality in (0,1]")
        super().__init__(pop_size=pop_size, max_iter=max_iter, **kwargs)
        self.m_enabled = bool(m_enabled)
        self.m_scale = float(m_scale)
        self.m_quality_alpha = float(m_quality_alpha)
        self.m_probability_alpha = float(m_probability_alpha)
        self.m_min_probability = float(m_min_probability)
        self.m_gain_weight = float(m_gain_weight)
        self.m_initial_quality = float(m_initial_quality)

    def _make_rng(self, seed):
        self._m_rng = np.random.default_rng(np.random.SeedSequence([seed, 57839]))
        return super()._make_rng(seed)

    def _reset_variant(self, dim):
        super()._reset_variant(dim)
        k = len(self.strategy_names)
        self._m_quality = np.full(k, self.m_initial_quality)
        self._m_probability = np.full(k, 1. / k)
        self._m_pending_strategy = None
        self._m_pending_index = None
        self.strategy_history = []

    def _explore_candidate(self, pop, i, best, scores, pcr, lb, ub, rng):
        if not self.m_enabled:
            return super()._explore_candidate(pop, i, best, scores, pcr, lb, ub, rng)
        n, dim = pop.shape
        current = pop[i]
        picks = rng.permutation(n)
        picks = picks[picks != i][:6]
        a, b, c, d, e, f = picks
        gain = 2. * rng.random() - 1.
        uniform_branch = rng.random() < 0.3
        self._m_pending_index, self._m_pending_strategy = i, None
        if uniform_branch:
            y = rng.uniform(lb, ub)
        else:
            strategy = int(self._m_rng.choice(len(self.strategy_names), p=self._m_probability))
            self._m_pending_strategy = strategy
            a, b, c, d, e, f = self._m_reference_indices(pop, i, picks, strategy)
            if strategy == 0:
                ab, cd, ef = pop[a] - pop[b], pop[c] - pop[d], pop[e] - pop[f]
                y = pop[a] + gain * ab + gain * ((ab - cd) + (cd - ef))
            elif strategy == 1:
                y = pop[a] + self.m_scale * (pop[b] - pop[c])
            else:
                attraction = self._m_rng.random()
                y = (current + attraction * (pop[a] - current)
                     + self.m_scale * (pop[b] - pop[c]))
        y = np.clip(y, lb, ub)
        j0 = rng.integers(dim)
        effective_pcr = self._m_crossover_rate(pcr, dim, uniform_branch)
        mask = rng.random(dim) <= effective_pcr
        mask[j0] = True
        candidate = np.where(mask, y, current)
        if not uniform_branch:
            candidate = self._m_step_hook(candidate, current)
        return candidate

    def _m_crossover_rate(self, pcr, dim, uniform_branch):

        return pcr

    def _m_reference_indices(self, pop, i, picks, strategy):

        return tuple(picks)

    def _m_step_hook(self, candidate, current):

        return candidate

    def _exploration(self, pop, fitness, best, scores, lb, ub, rng, evaluate):
        if not self.m_enabled:
            return super()._exploration(pop, fitness, best, scores, lb, ub, rng, evaluate)


        order = np.argsort(fitness, kind="stable")
        parent_fitness = fitness[order].copy()
        before_probability = self._m_probability.copy()
        before_quality = self._m_quality.copy()
        k = len(self.strategy_names)
        attempts, successes = np.zeros(k, dtype=int), np.zeros(k, dtype=int)
        rewards, gains = np.zeros(k), np.zeros(k)
        self._m_pending_strategy, self._m_pending_index = None, None

        def evaluated_feedback(candidate):
            value = evaluate(candidate)
            strategy, index = self._m_pending_strategy, self._m_pending_index
            if strategy is not None:
                old = float(parent_fitness[index])
                success = value < old
                normalized_gain = 0.
                if success:


                    scale = max(1., abs(old), abs(value))
                    old_scaled, new_scaled = old / scale, value / scale
                    denominator = abs(old_scaled) + abs(new_scaled) + 1e-12
                    normalized_gain = float(np.clip((old_scaled-new_scaled) / denominator, 0., 1.))
                reward = (1. - self.m_gain_weight) * float(success) + self.m_gain_weight * normalized_gain
                attempts[strategy] += 1
                successes[strategy] += int(success)
                gains[strategy] += normalized_gain
                rewards[strategy] += reward
                self._m_quality[strategy] += self.m_quality_alpha * (reward - self._m_quality[strategy])
            self._m_pending_strategy, self._m_pending_index = None, None
            return value

        result = super()._exploration(pop, fitness, best, scores, lb, ub, rng, evaluated_feedback)
        if attempts.sum():
            quality_sum = float(self._m_quality.sum())
            shares = (self._m_quality / quality_sum if quality_sum > np.finfo(float).tiny
                      else np.full(k, 1. / k))
            target = self.m_min_probability + (1. - k*self.m_min_probability) * shares
            self._m_probability = ((1. - self.m_probability_alpha)*self._m_probability
                                   + self.m_probability_alpha*target)
            self._m_probability /= self._m_probability.sum()

        for index, name in enumerate(self.strategy_names):
            count = int(attempts[index])
            self.strategy_history.append({
                "iteration": self._iteration, "phase": self._phase, "fes": self._fes,
                "strategy": name, "reference_policy": "FITNESS_DISTANCE" if getattr(self, "f_enabled", False) else "UNIFORM",
                "attempts": count, "successes": int(successes[index]),
                "success_rate": float(successes[index]/count) if count else "",
                "mean_normalized_gain": float(gains[index]/count) if count else "",
                "mean_reward": float(rewards[index]/count) if count else "",
                "quality_before": float(before_quality[index]),
                "quality_after": float(self._m_quality[index]),
                "probability_before": float(before_probability[index]),
                "probability_after": float(self._m_probability[index]),
            })
        return result


"""F reference selection shared by FOA and MFPOA.

FOA is the user-requested label for the F-only POA ablation. F scores use
current-population average fitness ranks and distance to the CURRENT agent,
inspired by https://doi.org/10.1016/j.knosys.2019.105169 . This is not a
canonical FDB reproduction. MFPOA applies the same F policy to the selected
M strategy's base/reference or attraction target, using a strategy-specific
quality/distance balance. FOA retains its single POA_DIFF balance.
Other peers remain random. All weights are predeclared, not performance claims.
"""

from math import sqrt

import numpy as np


class FitnessGuideMixin:
    def __init__(self, pop_size=30, max_iter=200, f_enabled=True,
                 f_quality_weight=0.60, f_uniform_mix=0.05,
                 f_strategy_coupling=True,
                 f_strategy_quality_weights=(0.60, 0.35, 0.80), **kwargs):
        if not isinstance(f_enabled, (bool, np.bool_)):
            raise ValueError("f_enabled must be boolean")
        if not np.all(np.isfinite((f_quality_weight, f_uniform_mix))):
            raise ValueError("F parameters must be finite")
        if not 0 <= f_quality_weight <= 1 or not 0 <= f_uniform_mix <= 1:
            raise ValueError("F quality weight and uniform mix must be in [0,1]")
        if not isinstance(f_strategy_coupling, (bool, np.bool_)):
            raise ValueError("f_strategy_coupling must be boolean")
        weights = np.asarray(f_strategy_quality_weights, dtype=float)
        if weights.shape != (3,) or not np.all(np.isfinite(weights)) or np.any((weights < 0) | (weights > 1)):
            raise ValueError("Require three finite strategy quality weights in [0,1]")
        if weights[0] != f_quality_weight:
            raise ValueError("POA_DIFF quality weight must match the F-only quality weight")
        super().__init__(pop_size=pop_size, max_iter=max_iter, **kwargs)
        self.f_enabled = bool(f_enabled)
        self.f_quality_weight = float(f_quality_weight)
        self.f_uniform_mix = float(f_uniform_mix)
        self.f_strategy_coupling = bool(f_strategy_coupling)
        self.f_strategy_quality_weights = tuple(map(float, weights))

    def _make_rng(self, seed):
        self._f_rng = np.random.default_rng(np.random.SeedSequence([seed, 42191]))
        return super()._make_rng(seed)

    def _reset_variant(self, dim):
        super()._reset_variant(dim)
        self.guide_history = []
        self.coupling_history = []
        self._f_pending = None

    def _quality(self, fitness):
        _, inverse, counts = np.unique(fitness, return_inverse=True, return_counts=True)
        average_ranks = np.cumsum(counts)-0.5*(counts+1)
        return 1.0-average_ranks[inverse]/max(1, len(fitness)-1)

    def _reference_quality_weight(self, strategy):

        if (strategy is not None and self.f_strategy_coupling
                and getattr(self, "m_enabled", False)):
            return self.f_strategy_quality_weights[strategy]
        return self.f_quality_weight

    def _select_reference(self, pop, i, strategy=None):
        n, dim = pop.shape
        eligible = np.flatnonzero(np.arange(n) != i)
        quality = self._quality(self._f_live_fitness)[eligible]
        distances = np.linalg.norm((pop[eligible]-pop[i])/(self._ub-self._lb), axis=1)/sqrt(dim)
        maximum = float(distances.max())
        scaled_distance = distances/maximum if maximum > 0.0 else np.zeros_like(distances)
        quality_weight = self._reference_quality_weight(strategy)
        score = quality_weight*quality+(1.0-quality_weight)*scaled_distance
        total = float(score.sum())
        probability = score/total if total > 0.0 else np.full(len(eligible), 1.0/len(eligible))
        probability = (1.0-self.f_uniform_mix)*probability+self.f_uniform_mix/len(eligible)
        probability /= probability.sum()
        selected = int(self._f_rng.choice(len(eligible), p=probability))
        positive = probability[probability > 0.0]
        entropy = float(-np.sum(positive*np.log(positive))/np.log(len(eligible)))
        return int(eligible[selected]), {
            "quality": float(quality[selected]), "distance": float(distances[selected]),
            "scaled_distance": float(scaled_distance[selected]), "probability_entropy": entropy,
            "quality_weight": float(quality_weight),
            "distance_weight": float(1.0-quality_weight)}

    def _m_reference_indices(self, pop, i, picks, strategy):
        if not self.f_enabled:
            return super()._m_reference_indices(pop, i, picks, strategy)
        reference, info = self._select_reference(pop, i, strategy=strategy)


        others = picks[picks != reference][:5]
        info["strategy"] = self.strategy_names[strategy]
        info["strategy_index"] = strategy
        info["role"] = "ATTRACTION_TARGET" if strategy == 2 else "BASE_REFERENCE"
        self._f_pending = (i, info)
        return (reference, *map(int, others))

    def _explore_candidate(self, pop, i, best, scores, pcr, lb, ub, rng):
        if not self.f_enabled:
            return super()._explore_candidate(pop, i, best, scores, pcr, lb, ub, rng)
        self._f_pending = (i, None)
        if getattr(self, "m_enabled", False):

            return super()._explore_candidate(pop, i, best, scores, pcr, lb, ub, rng)

        n, dim = pop.shape
        current = pop[i]
        picks = rng.permutation(n)
        picks = picks[picks != i]
        gain = 2.0*rng.random()-1.0
        uniform_branch = rng.random() < 0.5
        info = None
        if uniform_branch:
            y = rng.uniform(lb, ub)
        else:
            a, info = self._select_reference(pop, i)
            b, c, d, e, f = picks[picks != a][:5]
            ab, cd, ef = pop[a]-pop[b], pop[c]-pop[d], pop[e]-pop[f]
            y = pop[a]+gain*ab+gain*((ab-cd)+(cd-ef))
            info["strategy"], info["role"], info["strategy_index"] = "POA_DIFF", "BASE_REFERENCE", 0
        y = np.clip(y, lb, ub)
        forced = rng.integers(dim)
        mask = rng.random(dim) <= pcr
        mask[forced] = True
        self._f_pending = (i, info)
        return np.clip(np.where(mask, y, current), lb, ub)

    def _exploration(self, pop, fitness, best, scores, lb, ub, rng, evaluate):
        if not self.f_enabled:
            return super()._exploration(pop, fitness, best, scores, lb, ub, rng, evaluate)
        order = np.argsort(fitness, kind="stable")
        self._f_live_fitness = fitness[order].copy()
        self._f_pending = None
        attempts = successes = uniform_attempts = 0
        sums = {key: 0.0 for key in ("quality", "distance", "scaled_distance", "probability_entropy",
                                    "quality_weight", "distance_weight")}
        base_references = attraction_targets = 0
        m_active = bool(getattr(self, "m_enabled", False))
        if m_active:
            probability_before = self._m_probability.copy()
            strategy_attempts, strategy_successes = [0]*3, [0]*3
            strategy_sums = [{key: 0.0 for key in sums} for _ in range(3)]

        def feedback(candidate):
            nonlocal attempts, successes, uniform_attempts, base_references, attraction_targets
            value = evaluate(candidate)
            index, info = self._f_pending
            improved = value < self._f_live_fitness[index]
            if info is None:
                uniform_attempts += 1
            else:
                attempts += 1
                successes += int(improved)
                base_references += int(info["role"] == "BASE_REFERENCE")
                attraction_targets += int(info["role"] == "ATTRACTION_TARGET")
                for key in sums:
                    sums[key] += info[key]
                if m_active:
                    strategy = info["strategy_index"]
                    strategy_attempts[strategy] += 1
                    strategy_successes[strategy] += int(improved)
                    for key in sums:
                        strategy_sums[strategy][key] += info[key]
            if improved:
                self._f_live_fitness[index] = value
            self._f_pending = None
            return value

        result = super()._exploration(pop, fitness, best, scores, lb, ub, rng, feedback)
        self.guide_history.append({
            "iteration": self._iteration, "phase": self._phase, "fes": self._fes,
            "differential_attempts": attempts, "differential_successes": successes,
            "differential_success_rate": successes/attempts if attempts else "",
            "uniform_attempts": uniform_attempts,
            "base_reference_attempts": base_references, "attraction_target_attempts": attraction_targets,
            **{"mean_reference_"+key: value/attempts if attempts else ""
               for key, value in sums.items()}})
        if m_active:


            for strategy, name in enumerate(self.strategy_names):
                count = strategy_attempts[strategy]
                weight = self._reference_quality_weight(strategy)
                self.coupling_history.append({
                    "iteration": self._iteration, "phase": self._phase, "fes": self._fes,
                    "strategy": name, "coupling_enabled": self.f_strategy_coupling,
                    "reference_role": "ATTRACTION_TARGET" if strategy == 2 else "BASE_REFERENCE",
                    "quality_weight": weight, "distance_weight": 1.0-weight,
                    "attempts": count, "successes": strategy_successes[strategy],
                    "success_rate": strategy_successes[strategy]/count if count else "",
                    "probability_before": float(probability_before[strategy]),
                    "probability_after": float(self._m_probability[strategy]),
                    **{"mean_reference_"+key: value/count if count else ""
                       for key, value in strategy_sums[strategy].items()}})
        return result


"""M + F POA, with shared H rules active at both D10 and D20 by default.

At D <= h_reference_dim, or h_enabled=False, search behavior matches the
uploaded original MFPOA. Extra hooks make no objective calls or RNG draws.
Default reference_dim=6 activates H at both CEC2022 dimensions (10/20).
H is an additional mechanism, not a claim of demonstrated performance gain.
"""

import numpy as np


class MFPOA(FitnessGuideMixin, MultiStrategyMixin, POA):
    name = "MFPOA"

    def __init__(self, pop_size=30, max_iter=200, h_enabled=True,
                 h_reference_dim=6, h_unique_warmup=True,
                 h_uniform_crossover=True, **kwargs):
        for name, value in (("h_enabled", h_enabled),
                            ("h_unique_warmup", h_unique_warmup),
                            ("h_uniform_crossover", h_uniform_crossover)):
            if not isinstance(value, (bool, np.bool_)):
                raise ValueError(name + " must be boolean")
        if (isinstance(h_reference_dim, (bool, np.bool_))
                or not isinstance(h_reference_dim, (int, np.integer))
                or h_reference_dim < 2):
            raise ValueError("h_reference_dim must be an integer >= 2")
        super().__init__(pop_size=pop_size, max_iter=max_iter, **kwargs)
        self.h_enabled = bool(h_enabled)
        self.h_reference_dim = int(h_reference_dim)
        self.h_unique_warmup = bool(h_unique_warmup)
        self.h_uniform_crossover = bool(h_uniform_crossover)

    def _reset_variant(self, dim):
        super()._reset_variant(dim)
        self.diagnostics_history = []
        self.warmup_survival_history = []
        self._h_uniform_rates = []

    def _h_active(self, dim):

        return (self.h_enabled and dim > self.h_reference_dim
                and self.m_enabled and self.f_enabled)

    def _select_warmup_survivors(self, population, cost, n):
        dim = population.shape[1]
        order = np.argsort(cost, kind="stable")
        enabled = self._h_active(dim) and self.h_unique_warmup
        original = order[:n]
        if enabled:


            _, first = np.unique(population[order], axis=0, return_index=True)
            distinct = order[np.sort(first)]
            keep = distinct[:n]
            if len(keep) < n:


                remaining = order[~np.isin(order, keep)]
                keep = np.concatenate((keep, remaining[:n-len(keep)]))
            keep = keep[np.argsort(cost[keep], kind="stable")]
        else:
            keep = super()._select_warmup_survivors(population, cost, n)
        self.warmup_survival_history.append({
            "iteration": self._iteration, "dimension": dim,
            "unique_priority_enabled": enabled, "pool_size": len(cost),
            "pool_unique_positions": len(np.unique(population, axis=0)),
            "original_selection_unique_positions": len(np.unique(population[original], axis=0)),
            "selected_unique_positions": len(np.unique(population[keep], axis=0)),
            "survivors": len(keep), "additional_objective_calls": 0})
        return keep

    def _m_crossover_rate(self, pcr, dim, uniform_branch):
        rate = super()._m_crossover_rate(pcr, dim, uniform_branch)
        if uniform_branch and self._h_active(dim) and self.h_uniform_crossover:
            rate *= (self.h_reference_dim - 1) / (dim - 1)
        if uniform_branch:
            self._h_uniform_rates.append((float(pcr), float(rate)))
        return rate

    def _observe_population(self, population, cost, lb, ub):
        n, dim = population.shape
        normalized = (population-lb)/(ub-lb)
        rates = np.asarray(self._h_uniform_rates, dtype=float)
        self._h_uniform_rates.clear()
        self.diagnostics_history.append({
            "iteration": self._iteration, "phase": self._phase,
            "fes": self._fes, "dimension": dim, "h_active": self._h_active(dim),
            "unique_positions": len(np.unique(population, axis=0)),
            "population": n,
            "normalized_rms_spread": float(np.sqrt(np.mean(np.var(normalized, axis=0)))),
            "boundary_coordinate_fraction": float(np.mean((population == lb)|(population == ub))),
            "uniform_attempts_since_observation": len(rates),
            "mean_original_uniform_pcr": float(rates[:,0].mean()) if len(rates) else "",
            "mean_effective_uniform_pcr": float(rates[:,1].mean()) if len(rates) else "",
            "expected_uniform_crossed_coordinates": float(1+(dim-1)*rates[:,1].mean()) if len(rates) else "",
            "population_best_f": float(np.min(cost))})



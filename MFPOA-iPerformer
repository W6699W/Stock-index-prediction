def predict_mean_only(model, X_tensor, batch_size=256):
    model.eval()

    loader = DataLoader(
        TensorDataset(X_tensor),
        batch_size=batch_size,
        shuffle=False
    )

    preds = []

    with torch.no_grad():
        for (xb,) in loader:
            xb = xb.to(device)

            out = model(xb)
            pred = out.squeeze(-1)

            preds.append(pred.cpu().numpy())

    preds = np.concatenate(preds, axis=0)

    return scaler_y.inverse_transform(preds.reshape(-1, 1))


def permutation_importance_time_series(
    model,
    X_np,
    y_true_inv,
    feature_names,
    n_repeats=3
):
    baseline_pred = predict_mean_only(
        model,
        torch.tensor(X_np, dtype=torch.float32)
    )

    baseline_rmse = rmse_score(y_true_inv, baseline_pred)
    baseline_mae = mean_absolute_error(y_true_inv, baseline_pred)

    results = []
    rng = np.random.default_rng(SEED)

    for j, fname in enumerate(feature_names):
        rmse_list = []
        mae_list = []

        for _ in range(n_repeats):
            X_perm = X_np.copy()

            perm_idx = rng.permutation(X_perm.shape[0])
            X_perm[:, :, j] = X_perm[perm_idx, :, j]

            pred_perm = predict_mean_only(
                model,
                torch.tensor(X_perm, dtype=torch.float32)
            )

            rmse_perm = rmse_score(y_true_inv, pred_perm)
            mae_perm = mean_absolute_error(y_true_inv, pred_perm)

            rmse_list.append(rmse_perm)
            mae_list.append(mae_perm)

        results.append({
            "Feature": fname,
            "Baseline_RMSE": baseline_rmse,
            "Permuted_RMSE": np.mean(rmse_list),
            "RMSE_Increase": np.mean(rmse_list) - baseline_rmse,
            "Baseline_MAE": baseline_mae,
            "Permuted_MAE": np.mean(mae_list),
            "MAE_Increase": np.mean(mae_list) - baseline_mae
        })

        print(
            f"Permutation Importance | {fname}: "
            f"RMSE Increase = {results[-1]['RMSE_Increase']:.6f}"
        )

    imp_df = pd.DataFrame(results).sort_values(
        "RMSE_Increase",
        ascending=False
    )

    return imp_df



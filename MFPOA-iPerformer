def collect_local_global_branch_rms(X_tensor, batch_size=256):

    model.eval()
    square_sums = np.zeros((NUM_LAYERS, 2), dtype=np.float64)
    element_count = 0
    loader = DataLoader(TensorDataset(X_tensor), batch_size=batch_size, shuffle=False)
    with torch.no_grad():
        for (xb,) in loader:
            hidden = model.input_embedding(xb.to(device))
            if model.time_pos_embed is not None:
                hidden = hidden + model.time_pos_embed[:, :hidden.size(1), :]
            element_count += hidden.numel()
            for layer_idx, layer in enumerate(model.layers):
                global_update, local_update = layer.branch_updates(hidden)
                square_sums[layer_idx, 0] += global_update.square().sum().item()
                square_sums[layer_idx, 1] += local_update.square().sum().item()
                hidden = hidden + global_update + local_update
                hidden = hidden + layer.ffn(layer.norm2(hidden))

    rms = np.sqrt(square_sums / element_count)
    return pd.DataFrame({
        "Layer": np.arange(1, NUM_LAYERS + 1),
        "Global_RMS": rms[:, 0],
        "Local_RMS": rms[:, 1],
        "Local_to_Global_RMS": rms[:, 1] / np.maximum(rms[:, 0], 1e-12),
    })



def gradient_saliency(model, X_tensor, max_samples=512):
    model.eval()

    n = min(max_samples, X_tensor.shape[0])

    x = X_tensor[:n].clone().detach().to(device)
    x.requires_grad = True

    out = model(x)
    mean_pred = out.squeeze(-1)

    score = mean_pred.mean()

    model.zero_grad()
    score.backward()

    saliency = x.grad.detach().abs().cpu().numpy()
    saliency_mean = saliency.mean(axis=0)

    return saliency_mean


